#!/system/bin/sh

SU=/system/bin/su

TERMUX_DATA=/data/data/com.termux
TERMUX_PREFIX=/data/data/com.termux/files/usr
TERMUX_HOME=/data/data/com.termux/files/home

# libtermux-exec.so is the stable public name (symlink to whichever variant
# is active on this device). libtermux-exec-ld-preload.so is an internal
# variant file — do not hardcode it.
TERMUX_EXEC=/data/data/com.termux/files/usr/lib/libtermux-exec.so

die() { echo "txsu: ERROR: $*" >&2; exit 1; }

[ "$(id -u)" = 0 ] || die "must run as root"
[ -d "$TERMUX_DATA" ]  || die "Termux data directory not found: is Termux installed?"
[ -d "$TERMUX_HOME" ]  || die "Termux home not found: open Termux at least once first"
[ -f "$TERMUX_EXEC" ]  || die "libtermux-exec.so not found: run 'pkg install termux-exec' in Termux"

# Shell detection — honour the user's own Termux shell preference first.
# ~/.termux/shell is the file Termux itself writes when you run 'chsh'.
# Fall back to bash (Termux's default), then zsh, then give up.
TERMUX_SHELL_LINK="$TERMUX_HOME/.termux/shell"
if [ -x "$TERMUX_SHELL_LINK" ]; then
    TERMUX_SHELL="$(readlink -f "$TERMUX_SHELL_LINK" 2>/dev/null || echo "$TERMUX_SHELL_LINK")"
elif [ -x "$TERMUX_PREFIX/bin/bash" ]; then
    TERMUX_SHELL="$TERMUX_PREFIX/bin/bash"
elif [ -x "$TERMUX_PREFIX/bin/zsh" ]; then
    TERMUX_SHELL="$TERMUX_PREFIX/bin/zsh"
else
    die "no usable shell found — install one: pkg install bash"
fi

[ -x "$TERMUX_SHELL" ] || die "resolved shell '$TERMUX_SHELL' is not executable"

# ZDOTDIR: only set for zsh, and only when the XDG config dir actually exists.
# Setting it for users who keep .zshrc in $HOME would break their config.
ZDOTDIR_EXPORT=""
case "$TERMUX_SHELL" in
    */zsh)
        if [ -d "$TERMUX_HOME/.config/zsh" ]; then
            ZDOTDIR_EXPORT="export ZDOTDIR='$TERMUX_HOME/.config/zsh'"
        fi
        ;;
esac

TUID="$(stat -c '%u' "$TERMUX_DATA")" || die "cannot determine Termux UID"
TGID="$(stat -c '%g' "$TERMUX_DATA")" || die "cannot determine Termux GID"
IGID="$(stat -c '%g' /dev/socket/dnsproxyd)" || die "cannot determine inet group"
SGID="$(stat -c '%g' /storage 2>/dev/null)" \
    || { echo "txsu: warning: cannot determine storage group, continuing without it" >&2; SGID=""; }

# -c passthrough: pass the command via env var to avoid quoting issues
# through the su -c "..." shell layer.
TXSU_CMD=""
if [ "$1" = "-c" ]; then
    [ -n "$2" ] || die "-c requires an argument"
    TXSU_CMD="$2"
    export TXSU_CMD
fi

SUPP_GROUPS="-G $IGID"
[ -n "$SGID" ] && SUPP_GROUPS="$SUPP_GROUPS -G $SGID"

# $SUPP_GROUPS is intentionally unquoted: we need word splitting so that
# "-G 1234 -G 5678" expands to four separate arguments, not one string.
# shellcheck disable=SC2086
"$SU" \
    -g "$TGID" \
    $SUPP_GROUPS \
    "$TUID" \
    /system/bin/sh \
    -c "
        export HOME='$TERMUX_HOME'
        export PREFIX='$TERMUX_PREFIX'
        $ZDOTDIR_EXPORT

        export TERM='xterm-256color'
        export LANG=\"\${LANG:-en_US.UTF-8}\"

        export TERMUX__ROOTFS_DIR='$TERMUX_DATA/files'
        export TERMUX__HOME='$TERMUX_HOME'
        export TERMUX__PREFIX='$TERMUX_PREFIX'
        export TERMUX__UID='$TUID'

        export TERMUX_APP__PACKAGE_NAME='com.termux'
        export TERMUX_APP__DATA_DIR='$TERMUX_DATA'

        export SHELL='$TERMUX_SHELL'
        export EXTERNAL_STORAGE='/sdcard'

        export ANDROID_ROOT='/system'
        export ANDROID_DATA='/data'
        export ANDROID_STORAGE='/storage'
        export ANDROID_ASSETS='/system/app'
        export ANDROID_ART_ROOT='/apex/com.android.art'
        export ANDROID_I18N_ROOT='/apex/com.android.i18n'
        export ANDROID_TZDATA_ROOT='/apex/com.android.tzdata'

        export PATH='$TERMUX_PREFIX/bin:$TERMUX_PREFIX/bin/applets:/system/bin:/system/xbin:/system/sbin:/sbin:/sbin/bin'
        export TMPDIR='$TERMUX_PREFIX/tmp'

        unset LD_LIBRARY_PATH
        export LD_PRELOAD='$TERMUX_EXEC'

        cd '$TERMUX_HOME' || exit 1

        # chsh wrapper: fix SELinux MCS context on ~/.termux/shell after chsh runs.
        # Files created under su inherit root's label and lose the app's MCS categories,
        # making them unreadable by the Termux user. We copy the context from HOME itself
        # (guaranteed correct) onto the symlink chsh just wrote.
        chsh() {
            command chsh "$@" || return $?
            _sl="${HOME}/.termux/shell"
            [ -L "$_sl" ] || return 0
            _ctx="$(stat -c '%C' "$HOME" 2>/dev/null)"
            [ -n "$_ctx" ] && chcon "$_ctx" "$_sl" 2>/dev/null
            unset _sl _ctx
        }
        if [ -n \"\$TXSU_CMD\" ]; then
            exec '$TERMUX_SHELL' -c \"\$TXSU_CMD\"
        else
            exec '$TERMUX_SHELL' -l -i
        fi
    "

RC=$?
[ "$RC" -ne 0 ] && echo "" && echo "txsu: shell exited with status $RC"
exit "$RC"
