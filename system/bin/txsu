#!/system/bin/sh
# txsu — TermuxSu-Magisk
# Invoke a full Termux shell from any Android root shell.
#
# Flow:
#   1. Load cache (/data/adb/txsu/cache) if valid → exec immediately
#   2. Cache miss/stale/invalid → detect everything from live system → cache → exec
#   3. Termux not installed → warn → exec su - (root login shell)
#
# Usage:
#   txsu                    interactive Termux shell
#   txsu -c "command"       run command in Termux env and exit
#   txsu <bin> [args...]    exec Termux binary directly with Termux env
#   txsu --refresh          force cache refresh then open shell
#   txsu -h | --help        show help
#
# Alias: 'termux' -> symlink to txsu (created at boot by service.sh)
#
# SPDX-License-Identifier: MIT
# https://github.com/mariayuno/TermuxSu-Magisk

# ── constants ─────────────────────────────────────────────────────────────────

TERMUX_PKG="com.termux"
TERMUX_DATA="/data/data/${TERMUX_PKG}"
TERMUX_PREFIX="${TERMUX_DATA}/files/usr"
TERMUX_HOME="${TERMUX_DATA}/files/home"

CACHE_DIR="/data/adb/txsu"
CACHE_FILE="${CACHE_DIR}/cache"
CACHE_MAX_AGE=604800   # 7 days in seconds

# ── helpers ───────────────────────────────────────────────────────────────────

die()  { printf '[txsu] ERROR: %s\n' "$*" >&2; exit 1; }
info() { printf '[txsu] %s\n'        "$*" >&2; }
warn() { printf '[txsu] WARN:  %s\n' "$*" >&2; }

usage() {
  cat >&2 <<'USAGE'
txsu — TermuxSu-Magisk

  txsu                    Open interactive Termux shell
  txsu -c <cmd>           Run <cmd> in Termux environment
  txsu <bin> [args...]    Exec Termux binary directly
  txsu --refresh          Force cache refresh, then open shell
  txsu -h | --help        Show this help

Cache: /data/adb/txsu/cache (auto-invalidated on Termux update, UID change, or after 7 days)
USAGE
  exit 0
}

now() { date +%s 2>/dev/null || cat /proc/uptime | cut -d. -f1; }

# ── preflight ─────────────────────────────────────────────────────────────────

[ "$(id -u)" = "0" ] || die "txsu must be run as root"

# ── parse args ────────────────────────────────────────────────────────────────

MODE="interactive"
CMD=""
EXEC_BIN=""
EXEC_ARGS=""
FORCE_REFRESH=0

case "${1:-}" in
  -h|--help)    usage ;;
  --refresh)    FORCE_REFRESH=1 ;;
  -c)
    [ -n "${2:-}" ] || die "-c requires an argument"
    MODE="cmd"; CMD="$2"
    ;;
  "")
    MODE="interactive"
    ;;
  *)
    MODE="exec"
    EXEC_BIN="$1"; shift; EXEC_ARGS="$*"
    ;;
esac

# ── fallback: no Termux → su - ───────────────────────────────────────────────

fallback_su() {
  warn "Termux not found on this device"
  warn "Falling back to root login shell (su -)"
  exec /system/bin/su -
}

# ── cache: validate ───────────────────────────────────────────────────────────
# Returns 0 (valid) or 1 (invalid/stale/missing).
# Checks: file exists, all required keys present, age < 7d, UID matches fs,
#         Termux version matches installed app.

cache_valid() {
  [ -f "$CACHE_FILE" ] || return 1

  # source it into a subshell to validate keys without polluting our env
  _valid=$(
    . "$CACHE_FILE" 2>/dev/null || exit 1

    # required keys
    for _k in TERMUX_UID TERMUX_SHELL TERMUX_SELINUX_TYPE \
               TERMUX_SELINUX_CATS TERMUX_VERSION CACHE_TS; do
      eval "_v=\$$_k"
      [ -n "$_v" ] || exit 1
    done

    # age check
    _age=$(( $(date +%s 2>/dev/null || echo 0) - ${CACHE_TS:-0} ))
    [ "$_age" -lt "$CACHE_MAX_AGE" ] || exit 1

    # UID must still match filesystem
    _fs_uid=$(stat -c '%u' "$TERMUX_DATA" 2>/dev/null) \
      || _fs_uid=$(ls -lnd "$TERMUX_DATA" 2>/dev/null | awk '{print $3}')
    [ "${TERMUX_UID}" = "${_fs_uid}" ] || exit 1

    # Termux version must match (catches app updates/reinstalls)
    _live_ver=$(
      dumpsys package "$TERMUX_PKG" 2>/dev/null \
        | grep versionCode | head -1 | tr -d ' ' | cut -d= -f2
    )
    # dumpsys may fail under ksu — read from stored apk path env var as fallback
    if [ -z "$_live_ver" ]; then
      _apk=$(cat "$TERMUX_DATA/../../../app/*/base.apk" 2>/dev/null) || true
      # can't verify version without dumpsys — skip version check, rely on age+UID
      echo "ok"; exit 0
    fi
    [ "${TERMUX_VERSION}" = "${_live_ver}" ] || exit 1

    echo "ok"
  )
  [ "$_valid" = "ok" ]
}

# ── cache: write ──────────────────────────────────────────────────────────────

cache_write() {
  mkdir -p "$CACHE_DIR" && chmod 700 "$CACHE_DIR" || {
    warn "Cannot write cache to $CACHE_DIR — will redetect each run"
    return 1
  }

  cat > "$CACHE_FILE" <<EOF
# TermuxSu-Magisk cache — do not edit manually
# Regenerate with: txsu --refresh
TERMUX_UID=${TERMUX_UID}
TERMUX_SHELL=${TERMUX_SHELL}
TERMUX_LD_PRELOAD=${TERMUX_LD_PRELOAD}
TERMUX_SELINUX_TYPE=${TERMUX_SELINUX_TYPE}
TERMUX_SELINUX_CATS=${TERMUX_SELINUX_CATS}
TERMUX_VERSION=${TERMUX_VERSION}
CACHE_TS=$(now)
EOF
  chmod 600 "$CACHE_FILE"
  info "Cache written to $CACHE_FILE"
}

# ── cache: load ───────────────────────────────────────────────────────────────

cache_load() {
  . "$CACHE_FILE"
  # rebuild full SELinux context from cached parts
  SELINUX_CTX="u:r:${TERMUX_SELINUX_TYPE}:s0:${TERMUX_SELINUX_CATS}"
}

# ── detection: full ───────────────────────────────────────────────────────────

detect_all() {
  # ── Termux installed? ──────────────────────────────────────────────────────
  [ -d "$TERMUX_PREFIX" ] || fallback_su

  # ── UID ───────────────────────────────────────────────────────────────────
  TERMUX_UID=""
  TERMUX_UID=$(stat -c '%u' "$TERMUX_DATA" 2>/dev/null) \
    || TERMUX_UID=$(ls -lnd "$TERMUX_DATA" 2>/dev/null | awk '{print $3}')
  [ -n "$TERMUX_UID" ] && [ "$TERMUX_UID" -gt 0 ] 2>/dev/null \
    || die "Could not resolve Termux UID"

  # ── Termux version (for cache invalidation) ────────────────────────────────
  TERMUX_VERSION=$(
    dumpsys package "$TERMUX_PKG" 2>/dev/null \
      | grep versionCode | head -1 | tr -d ' ' | cut -d= -f2
  )
  # fallback: read from Termux's own env var file or apk path
  if [ -z "$TERMUX_VERSION" ]; then
    TERMUX_VERSION=$(
      strings "${TERMUX_DATA}/../../../app/"*"/base.apk" 2>/dev/null \
        | grep -m1 '^[0-9]\{4\}$'
    ) || TERMUX_VERSION="unknown"
  fi

  # ── find live Termux PID ───────────────────────────────────────────────────
  TERMUX_PID=""
  for _pid in /proc/[0-9]*; do
    _pid="${_pid##*/}"
    _owner=$(stat -c '%u' "/proc/$_pid" 2>/dev/null) || continue
    [ "$_owner" = "$TERMUX_UID" ] || continue
    _cmd=$(cat "/proc/$_pid/cmdline" 2>/dev/null | tr '\0' ' ')
    case "$_cmd" in
      *${TERMUX_PKG}*)
        TERMUX_PID="$_pid"
        break
        ;;
    esac
    [ -z "$TERMUX_PID" ] && TERMUX_PID="$_pid"
  done

  # ── SELinux context ────────────────────────────────────────────────────────
  TERMUX_SELINUX_TYPE=""
  TERMUX_SELINUX_CATS=""

  # Method 1: live process attr (most accurate)
  if [ -n "$TERMUX_PID" ]; then
    _ctx=$(cat "/proc/${TERMUX_PID}/attr/current" 2>/dev/null | tr -d '\0\n')
    case "$_ctx" in
      u:r:*:s0:*)
        TERMUX_SELINUX_TYPE=$(echo "$_ctx" | cut -d: -f3)
        TERMUX_SELINUX_CATS=$(echo "$_ctx" | cut -d: -f5-)
        # guard against truncated read (e.g. "utrusted_app_27" missing leading 'n')
        case "$TERMUX_SELINUX_TYPE" in
          utrusted_app*) TERMUX_SELINUX_TYPE="un${TERMUX_SELINUX_TYPE}" ;;
        esac
        info "SELinux from live process $TERMUX_PID: type=$TERMUX_SELINUX_TYPE cats=$TERMUX_SELINUX_CATS"
        ;;
    esac
  fi

  # Method 2: file label on data dir → derive process type from SDK
  if [ -z "$TERMUX_SELINUX_TYPE" ]; then
    _fctx=$(ls -ldZ "$TERMUX_DATA" 2>/dev/null | awk '{
      for(i=1;i<=NF;i++) if($i ~ /^u:/) { print $i; exit }
    }')
    if [ -n "$_fctx" ]; then
      TERMUX_SELINUX_CATS=$(echo "$_fctx" | grep -oE 'c[0-9]+(,c[0-9]+)*' | head -1)
      _sdk=$(getprop ro.build.version.sdk 2>/dev/null || echo 0)
      if   [ "$_sdk" -ge 28 ]; then TERMUX_SELINUX_TYPE="untrusted_app_27"
      elif [ "$_sdk" -ge 26 ]; then TERMUX_SELINUX_TYPE="untrusted_app_25"
      else                          TERMUX_SELINUX_TYPE="untrusted_app"
      fi
      info "SELinux from file label (SDK $_sdk): type=$TERMUX_SELINUX_TYPE cats=$TERMUX_SELINUX_CATS"
    fi
  fi

  # Method 3: pure formula — last resort
  if [ -z "$TERMUX_SELINUX_TYPE" ] || [ -z "$TERMUX_SELINUX_CATS" ]; then
    _sdk=$(getprop ro.build.version.sdk 2>/dev/null || echo 0)
    if   [ "$_sdk" -ge 28 ]; then TERMUX_SELINUX_TYPE="untrusted_app_27"
    elif [ "$_sdk" -ge 26 ]; then TERMUX_SELINUX_TYPE="untrusted_app_25"
    else                          TERMUX_SELINUX_TYPE="untrusted_app"
    fi
    _app_idx=$(( TERMUX_UID - 10000 ))
    TERMUX_SELINUX_CATS="c${_app_idx},c256,c512,c768"
    warn "SELinux from formula (last resort): type=$TERMUX_SELINUX_TYPE cats=$TERMUX_SELINUX_CATS"
  fi

  SELINUX_CTX="u:r:${TERMUX_SELINUX_TYPE}:s0:${TERMUX_SELINUX_CATS}"

  # ── DNS ───────────────────────────────────────────────────────────────────
  TERMUX_RESOLV="${TERMUX_PREFIX}/etc/resolv.conf"
  if [ ! -s "$TERMUX_RESOLV" ]; then
    mkdir -p "${TERMUX_PREFIX}/etc"
    {
      for _p in net.dns1 net.dns2 net.dns3 net.dns4; do
        _v=$(getprop "$_p" 2>/dev/null); [ -n "$_v" ] && printf 'nameserver %s\n' "$_v"
      done
      for _iface in wlan0 eth0 rmnet0 rmnet_data0; do
        for _n in 1 2; do
          _v=$(getprop "dhcp.${_iface}.dns${_n}" 2>/dev/null)
          [ -n "$_v" ] && printf 'nameserver %s\n' "$_v"
        done
      done
      [ -r /proc/net/pnp ] && grep '^nameserver' /proc/net/pnp 2>/dev/null
    } | awk '!seen[$0]++' > "${TERMUX_RESOLV}.tmp" 2>/dev/null
    if [ -s "${TERMUX_RESOLV}.tmp" ]; then
      mv "${TERMUX_RESOLV}.tmp" "$TERMUX_RESOLV"
      info "DNS populated from system properties"
    else
      rm -f "${TERMUX_RESOLV}.tmp"
      warn "Could not detect DNS — network may not work inside Termux shell"
    fi
  fi

  # ── shell ─────────────────────────────────────────────────────────────────
  TERMUX_SHELL=""
  # Method 1: passwd
  if [ -r "${TERMUX_PREFIX}/etc/passwd" ]; then
    _s=$(grep ":${TERMUX_HOME}:" "${TERMUX_PREFIX}/etc/passwd" 2>/dev/null \
      | tail -1 | cut -d: -f7)
    case "$_s" in
      /data/*) [ -x "$_s" ] && TERMUX_SHELL="$_s" ;;
      /bin/*)  [ -x "${TERMUX_PREFIX}${_s}" ] && TERMUX_SHELL="${TERMUX_PREFIX}${_s}" ;;
    esac
  fi
  # Method 2: live process env
  if [ -z "$TERMUX_SHELL" ] && [ -n "$TERMUX_PID" ]; then
    _s=$(cat "/proc/${TERMUX_PID}/environ" 2>/dev/null \
      | tr '\0' '\n' | grep '^SHELL=' | cut -d= -f2-)
    [ -x "$_s" ] && TERMUX_SHELL="$_s"
  fi
  # Method 3: scan bin/
  if [ -z "$TERMUX_SHELL" ]; then
    for _sh in zsh bash fish dash sh; do
      if [ -x "${TERMUX_PREFIX}/bin/${_sh}" ]; then
        TERMUX_SHELL="${TERMUX_PREFIX}/bin/${_sh}"; break
      fi
    done
  fi
  [ -n "$TERMUX_SHELL" ] || die "No usable shell found in ${TERMUX_PREFIX}/bin"

  # ── LD_PRELOAD ────────────────────────────────────────────────────────────
  TERMUX_LD_PRELOAD=""
  for _f in "${TERMUX_PREFIX}/lib/libtermux-exec"*.so; do
    [ -f "$_f" ] && TERMUX_LD_PRELOAD="$_f" && break
  done
  [ -z "$TERMUX_LD_PRELOAD" ] && \
    warn "libtermux-exec not found — some binaries may crash"

  info "Detected: uid=$TERMUX_UID shell=$TERMUX_SHELL selinux=$SELINUX_CTX"
}

# ── build runtime environment ─────────────────────────────────────────────────
# If Termux is running: copy /proc/<pid>/environ verbatim, override key vars.
# If not running: construct from filesystem.
# Called after detect_all or cache_load — TERMUX_* vars must be set.

build_runtime_env() {
  ENV_LINES=""

  # Try live process environ first
  if [ -n "${TERMUX_PID:-}" ]; then
    ENV_LINES=$(
      cat "/proc/${TERMUX_PID}/environ" 2>/dev/null \
        | tr '\0' '\n' \
        | grep -v '^$' \
        | grep -vE '^(HOME|SHELL|TERM|TMPDIR|LD_PRELOAD|SHLVL|PWD|OLDPWD|SSH_|_=)'
    ) || ENV_LINES=""
  fi

  # Fallback: construct from filesystem
  if [ -z "$ENV_LINES" ]; then
    _path="${TERMUX_PREFIX}/bin"
    for _d in \
      "${TERMUX_HOME}/.local/bin" \
      "${TERMUX_HOME}/bin" \
      "${TERMUX_HOME}/.local/share/cargo/bin" \
      "${TERMUX_HOME}/.local/share/go/bin" \
      "${TERMUX_PREFIX}/bin/applets" \
      /system/bin /system/xbin
    do
      [ -d "$_d" ] && _path="${_path}:${_d}"
    done

    ENV_LINES="PATH=${_path}
PREFIX=${TERMUX_PREFIX}
LD_LIBRARY_PATH=${TERMUX_PREFIX}/lib
LANG=$(getprop persist.sys.locale 2>/dev/null || echo en_US.UTF-8)
ANDROID_ROOT=$(getprop ro.build.android.root 2>/dev/null || echo /system)
ANDROID_DATA=/data
EXTERNAL_STORAGE=$(getprop ro.external.sd.path 2>/dev/null || echo /sdcard)
XDG_CONFIG_HOME=${TERMUX_HOME}/.config
XDG_DATA_HOME=${TERMUX_HOME}/.local/share
XDG_CACHE_HOME=${TERMUX_HOME}/.cache
XDG_STATE_HOME=${TERMUX_HOME}/.local/state
XDG_RUNTIME_DIR=${TERMUX_PREFIX}/tmp
TERMUX__PREFIX=${TERMUX_PREFIX}
TERMUX__HOME=${TERMUX_HOME}
TERMUX__UID=${TERMUX_UID}"
  fi

  # Always override these — must reflect the transition, not the old session
  ENV_LINES="${ENV_LINES}
HOME=${TERMUX_HOME}
SHELL=${TERMUX_SHELL}
TERM=${TERM:-xterm-256color}
TMPDIR=${TERMUX_PREFIX}/tmp
SHLVL=1"
  [ -n "$TERMUX_LD_PRELOAD" ] && \
    ENV_LINES="${ENV_LINES}
LD_PRELOAD=${TERMUX_LD_PRELOAD}"
}

# ── exec chain ────────────────────────────────────────────────────────────────
# runcon on KSU (u:r:ksu:s0) cannot transition to untrusted_app — the policy
# doesn't permit it. We probe with a no-op first; if it fails we skip it.
# We cannot use 'exec runcon ...' directly because exec replaces the process
# and a failed runcon has no recovery path.

do_exec() {
  _bin="$1"; shift
  if command -v runcon >/dev/null 2>&1 && [ -n "$SELINUX_CTX" ]; then
    # probe: can we actually set this context?
    runcon "$SELINUX_CTX" /system/bin/true 2>/dev/null
    if [ $? -eq 0 ]; then
      exec runcon "$SELINUX_CTX" \
        /system/bin/su "$TERMUX_UID" \
        /system/bin/env -i $ENV_LINES \
        "$_bin" "$@"
    else
      warn "runcon cannot set $SELINUX_CTX (policy denial) — skipping context switch"
    fi
  fi
  # fallback: plain uid drop, no SELinux context switch
  exec /system/bin/su "$TERMUX_UID" \
    /system/bin/env -i $ENV_LINES \
    "$_bin" "$@"
}

# ── main ──────────────────────────────────────────────────────────────────────

if [ "$FORCE_REFRESH" = "1" ] || ! cache_valid; then
  [ "$FORCE_REFRESH" = "1" ] && info "Forced refresh" || info "Cache miss — detecting..."
  detect_all
  cache_write
else
  info "Cache hit"
  cache_load
fi

# TERMUX_PID not cached (process state changes) — find it now for live env
# (only matters for build_runtime_env; non-fatal if not found)
if [ -z "${TERMUX_PID:-}" ]; then
  for _pid in /proc/[0-9]*; do
    _pid="${_pid##*/}"
    _owner=$(stat -c '%u' "/proc/$_pid" 2>/dev/null) || continue
    [ "$_owner" = "$TERMUX_UID" ] || continue
    _cmd=$(cat "/proc/$_pid/cmdline" 2>/dev/null | tr '\0' ' ')
    case "$_cmd" in *${TERMUX_PKG}*) TERMUX_PID="$_pid"; break ;; esac
    [ -z "${TERMUX_PID:-}" ] && TERMUX_PID="$_pid"
  done
fi

build_runtime_env

# resolve exec binary if needed
if [ "$MODE" = "exec" ]; then
  [ -x "${TERMUX_PREFIX}/bin/${EXEC_BIN}" ] \
    && EXEC_BIN="${TERMUX_PREFIX}/bin/${EXEC_BIN}"
  [ -x "$EXEC_BIN" ] || die "Binary not found: $EXEC_BIN"
fi

case "$MODE" in
  interactive) do_exec "$TERMUX_SHELL" --login ;;
  cmd)         do_exec "$TERMUX_SHELL" -c "$CMD" ;;
  exec)        do_exec "$EXEC_BIN" $EXEC_ARGS ;;
esac
