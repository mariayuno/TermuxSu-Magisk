#!/system/bin/sh

# txsu — Root-to-Termux shell bridge
# Root -> Termux shell bridge with dynamic SELinux MCS file creation context.

SU=/system/bin/su

TERMUX_DATA=/data/data/com.termux
TERMUX_FILES="$TERMUX_DATA/files"
TERMUX_PREFIX="$TERMUX_FILES/usr"
TERMUX_HOME="$TERMUX_FILES/home"
TERMUX_EXEC="$TERMUX_PREFIX/lib/libtermux-exec.so"

TXSU_LIB="$TERMUX_PREFIX/lib/libtxsu-fscreate.so"
TXSU_SRC="$TERMUX_PREFIX/tmp/txsu-fscreate.c"

die() {
    echo "txsu: ERROR: $*" >&2
    exit 1
}

warn() {
    echo "txsu: WARNING: $*" >&2
}

# ============================================================================
# Basic validation
# ============================================================================

[ "$(id -u)" = 0 ] || die "must run as root"
[ -x "$SU" ] || die "su not found: $SU"
[ -d "$TERMUX_DATA" ] || die "Termux data directory not found: $TERMUX_DATA"
[ -d "$TERMUX_HOME" ] || die "Termux HOME not found: $TERMUX_HOME"
[ -d "$TERMUX_PREFIX" ] || die "Termux PREFIX not found: $TERMUX_PREFIX"
[ -f "$TERMUX_EXEC" ] || die "libtermux-exec.so not found"

# ============================================================================
# Detect the user's Termux shell
# ============================================================================

TERMUX_SHELL_LINK="$TERMUX_HOME/.termux/shell"

if [ -x "$TERMUX_SHELL_LINK" ]; then
    TERMUX_SHELL="$(readlink -f "$TERMUX_SHELL_LINK" 2>/dev/null || true)"
    [ -n "$TERMUX_SHELL" ] || TERMUX_SHELL="$TERMUX_SHELL_LINK"
elif [ -x "$TERMUX_PREFIX/bin/zsh" ]; then
    TERMUX_SHELL="$TERMUX_PREFIX/bin/zsh"
elif [ -x "$TERMUX_PREFIX/bin/bash" ]; then
    TERMUX_SHELL="$TERMUX_PREFIX/bin/bash"
else
    die "no usable Termux shell found"
fi

[ -x "$TERMUX_SHELL" ] || die "shell is not executable: $TERMUX_SHELL"

# ============================================================================
# Termux UID / GID
# ============================================================================

TUID="$(stat -c '%u' "$TERMUX_DATA" 2>/dev/null)" ||
    die "cannot determine Termux UID"

TGID="$(stat -c '%g' "$TERMUX_DATA" 2>/dev/null)" ||
    die "cannot determine Termux GID"

[ -n "$TUID" ] || die "invalid Termux UID"
[ -n "$TGID" ] || die "invalid Termux GID"

# ============================================================================
# Android supplementary groups
# ============================================================================

IGID=""

if [ -e /dev/socket/dnsproxyd ]; then
    IGID="$(stat -c '%g' /dev/socket/dnsproxyd 2>/dev/null || true)"
fi

SGID=""

if [ -e /storage ]; then
    SGID="$(stat -c '%g' /storage 2>/dev/null || true)"
fi

SUPP_GROUPS=""

[ -n "$IGID" ] && SUPP_GROUPS="$SUPP_GROUPS -G $IGID"
[ -n "$SGID" ] && SUPP_GROUPS="$SUPP_GROUPS -G $SGID"

# ============================================================================
# Dynamically obtain Termux's actual SELinux file context.
#
# Example:
#   u:object_r:app_data_file:s0:c172,c256,c512,c768
#
# Nothing below hardcodes the MCS categories.
# ============================================================================

TERMUX_HOME_CTX="$(stat -c '%C' "$TERMUX_HOME" 2>/dev/null)" ||
    die "cannot determine Termux HOME SELinux context"

[ -n "$TERMUX_HOME_CTX" ] ||
    die "Termux HOME SELinux context is empty"

echo "txsu: UID              : $TUID" >&2
echo "txsu: GID              : $TGID" >&2
echo "txsu: shell            : $TERMUX_SHELL" >&2
echo "txsu: file context     : $TERMUX_HOME_CTX" >&2

# ============================================================================
# Build the preload helper once.
#
# The constructor runs inside every dynamically linked process which inherits
# LD_PRELOAD and sets /proc/self/attr/fscreate before main().
# ============================================================================

build_preload() {
    [ -f "$TXSU_LIB" ] && return 0

    local CLANG=""

    if [ -x "$TERMUX_PREFIX/bin/clang" ]; then
        CLANG="$TERMUX_PREFIX/bin/clang"
    elif [ -x "$TERMUX_PREFIX/bin/cc" ]; then
        CLANG="$TERMUX_PREFIX/bin/cc"
    fi

    if [ -z "$CLANG" ]; then
        die "$(cat <<ERRMSG
╔══════════════════════════════════════════════════════╗
║               !! DANGER — DO NOT IGNORE !!           ║
╠══════════════════════════════════════════════════════╣
║  clang is not installed in Termux.                   ║
║                                                      ║
║  Without it, txsu cannot build the SELinux context   ║
║  bridge. Running without it means EVERY FILE you     ║
║  create in this shell will have the WRONG SELinux    ║
║  label and will be UNREADABLE by native Termux.      ║
║                                                      ║
║  Fix: open Termux and run:                           ║
║       pkg install clang                              ║
║  Then retry txsu.                                    ║
╚══════════════════════════════════════════════════════╝
ERRMSG
)"
    fi

    echo "txsu: building SELinux preload library..." >&2

    mkdir -p "$TERMUX_PREFIX/tmp" ||
        die "cannot create Termux tmp directory"

    cat > "$TXSU_SRC" <<'EOF'
#include <fcntl.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

__attribute__((constructor))
static void txsu_set_fscreate(void)
{
    const char *ctx = getenv("TXSU_FSCREATE");
    int fd;

    if (!ctx || !*ctx)
        return;

    fd = open(
        "/proc/self/attr/fscreate",
        O_WRONLY | O_CLOEXEC
    );

    if (fd < 0)
        return;

    (void)write(fd, ctx, strlen(ctx));
    close(fd);
}
EOF

    "$CLANG" \
        -shared \
        -fPIC \
        -O2 \
        -Wl,-soname,libtxsu-fscreate.so \
        -o "$TXSU_LIB" \
        "$TXSU_SRC" ||
        die "failed to build $TXSU_LIB"

    chown "$TUID:$TGID" "$TXSU_LIB" ||
        die "failed to set ownership on $TXSU_LIB — aborting to prevent root-owned preload corrupting Termux files"
    chcon "$TERMUX_HOME_CTX" "$TXSU_LIB" 2>/dev/null || true
    chmod 755 "$TXSU_LIB"

    rm -f "$TXSU_SRC"

    [ -f "$TXSU_LIB" ] ||
        die "preload library was not created"
}

build_preload

# ============================================================================
# Optional command passthrough
# ============================================================================

TXSU_CMD=""

# ZDOTDIR: set for zsh only when ~/.config/zsh exists.
ZDOTDIR_EXPORT=""
case "$TERMUX_SHELL" in
    */zsh)
        [ -d "$TERMUX_HOME/.config/zsh" ] && ZDOTDIR_EXPORT="$TERMUX_HOME/.config/zsh"
        ;;
esac

if [ "$1" = "-c" ]; then
    [ -n "$2" ] || die "-c requires an argument"
    TXSU_CMD="$2"
fi

# ============================================================================
# Root -> Termux inner shell
#
# All values are passed as positional parameters to avoid nested quoting.
# ============================================================================

INNER='
TERMUX_HOME="$1"
TERMUX_PREFIX="$2"
TERMUX_FILES="$3"
TERMUX_DATA="$4"
TERMUX_SHELL="$5"
TERMUX_EXEC="$6"
TERMUX_FSCTX="$7"
TERMUX_PRELOAD="$8"
TXSU_CMD="$9"

export HOME="$TERMUX_HOME"
export PREFIX="$TERMUX_PREFIX"

export TERM="xterm-256color"
export LANG="${LANG:-en_US.UTF-8}"

export TERMUX__ROOTFS_DIR="$TERMUX_FILES"
export TERMUX__HOME="$TERMUX_HOME"
export TERMUX__PREFIX="$TERMUX_PREFIX"
export TERMUX__UID="$(id -u)"

export TERMUX_APP__PACKAGE_NAME="com.termux"
export TERMUX_APP__DATA_DIR="$TERMUX_DATA"

export SHELL="$TERMUX_SHELL"
[ -n "$TXSU_ZDOTDIR" ] && export ZDOTDIR="$TXSU_ZDOTDIR"
export EXTERNAL_STORAGE="/sdcard"

export ANDROID_ROOT="/system"
export ANDROID_DATA="/data"
export ANDROID_STORAGE="/storage"
export ANDROID_ASSETS="/system/app"
export ANDROID_ART_ROOT="/apex/com.android.art"
export ANDROID_I18N_ROOT="/apex/com.android.i18n"
export ANDROID_TZDATA_ROOT="/apex/com.android.tzdata"

export PATH="$TERMUX_PREFIX/bin:$TERMUX_PREFIX/bin/applets:/system/bin:/system/xbin:/system/sbin:/sbin:/sbin/bin"
export TMPDIR="$TERMUX_PREFIX/tmp"

unset LD_LIBRARY_PATH

# Dynamic SELinux context supplied by txsu.
export TXSU_FSCREATE="$TERMUX_FSCTX"

# Keep both our fscreate helper and Termux exec integration.
export LD_PRELOAD="$TERMUX_PRELOAD:$TERMUX_EXEC"

cd "$TERMUX_HOME" || exit 1

echo "txsu: process context   : $(id -Z 2>/dev/null)" >&2
echo "txsu: fscreate target   : $TXSU_FSCREATE" >&2

if [ -n "$TXSU_CMD" ]; then
    exec "$TERMUX_SHELL" -c "$TXSU_CMD"
else
    case "$TERMUX_SHELL" in
        */fish) exec "$TERMUX_SHELL" -i ;;
        *)      exec "$TERMUX_SHELL" -l -i ;;
    esac
fi
'

# ============================================================================
# Launch as the Termux UID/GID.
#
# Do NOT use -Z here.
# KernelSU remains u:r:ksu:s0; the MCS context is applied to new files.
# ============================================================================

# Pass ZDOTDIR via environment so the inner shell can pick it up
export TXSU_ZDOTDIR="$ZDOTDIR_EXPORT"

# shellcheck disable=SC2086
"$SU" \
    -g "$TGID" \
    $SUPP_GROUPS \
    "$TUID" \
    /system/bin/sh \
    -c "$INNER" \
    txsu \
    "$TERMUX_HOME" \
    "$TERMUX_PREFIX" \
    "$TERMUX_FILES" \
    "$TERMUX_DATA" \
    "$TERMUX_SHELL" \
    "$TERMUX_EXEC" \
    "$TERMUX_HOME_CTX" \
    "$TXSU_LIB" \
    "$TXSU_CMD"

RC=$?

[ "$RC" -ne 0 ] &&
    echo "txsu: shell exited with status $RC" >&2

exit "$RC"
