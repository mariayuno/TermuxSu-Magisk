#!/sbin/sh
# Magisk module installer — TermuxSu-Magisk

SKIPUNZIP=1

ui_print "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
ui_print "  TermuxSu-Magisk Installer"
ui_print "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Extract module files
ui_print "- Extracting files..."
unzip -o "$ZIPFILE" 'system/*'    -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'service.sh'  -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'module.prop' -d "$MODPATH" >&2

# Permissions
ui_print "- Setting permissions..."
set_perm "$MODPATH/system/bin/txsu" root root 0755 u:object_r:system_file:s0
set_perm "$MODPATH/service.sh"      root root 0755

ui_print "- Binary : /system/bin/txsu"
ui_print "- Alias  : /system/bin/termux (created at boot)"
ui_print "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
ui_print "  Done! Reboot to activate."
ui_print "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
