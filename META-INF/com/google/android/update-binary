#!/sbin/sh
# TermuxSu-Magisk installer
SKIPUNZIP=1
unzip -o "$ZIPFILE" 'system/*' -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'module.prop' -d "$MODPATH" >&2
set_perm "$MODPATH/system/bin/txsu" root root 0755 u:object_r:system_file:s0
ui_print "- TermuxSu-Magisk installed"
ui_print "- Binary: /system/bin/txsu"
ui_print "- Alias:  termux -> txsu"
